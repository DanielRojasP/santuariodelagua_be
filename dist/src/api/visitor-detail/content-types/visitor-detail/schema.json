{
    "kind": "collectionType",
    "collectionName": "visitor_details",
    "info": {
        "singularName": "visitor-detail",
        "pluralName": "visitor-details",
        "displayName": "VisitorDetail"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "complete_name": {
            "type": "string",
            "required": true
        },
        "id_or_passport": {
            "type": "string",
            "required": true
        },
        "phone_number": {
            "type": "string",
            "required": false
        },
        "gender": {
            "type": "enumeration",
            "required": true,
            "enum": [
                "MALE",
                "FEMALE",
                "OTHER"
            ]
        },
        "age_group": {
            "type": "enumeration",
            "required": true,
            "enum": [
                "CHILD_0_3",
                "CHILD_4_12",
                "YOUTH_13_17",
                "ADULT_18_59",
                "SENIOR_60_PLUS"
            ]
        },
        "nationality": {
            "type": "string",
            "required": true
        },
        "is_local": {
            "type": "boolean",
            "required": true
        },
        "province": {
            "type": "enumeration",
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "is_local"
                        },
                        true
                    ]
                }
            },
            "enum": [
                "SAN_JOSE",
                "ALAJUELA",
                "CARTAGO",
                "HEREDIA",
                "GUANACASTE",
                "PUNTARENAS",
                "LIMON"
            ]
        },
        "guardian": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::guardian.guardian",
            "required": false
        }
    }
}
