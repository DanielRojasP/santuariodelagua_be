{
  "kind": "collectionType",
  "collectionName": "visitor_details",
  "info": {
    "singularName": "visitor-detail",
    "pluralName": "visitor-details",
    "displayName": "VisitorDetail"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "complete_name": {
      "type": "string",
      "required": false
    },
    "id_or_passport": {
      "type": "string",
      "required": false
    },
    "phone_number": {
      "type": "string",
      "required": false
    },
    "gender": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "MALE",
        "FEMALE",
        "OTHER"
      ]
    },
    "age_group": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "CHILD_0_3",
        "CHILD_4_12",
        "ADULT_OR_YOUTH_13_64",
        "SENIOR_65_PLUS"
      ]
    },
    "nationality": {
      "type": "string",
      "required": false
    },
    "is_local": {
      "type": "boolean",
      "required": true
    },
    "province": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "is_local"
            },
            true
          ]
        }
      },
      "enum": [
        "SAN_JOSE",
        "ALAJUELA",
        "CARTAGO",
        "HEREDIA",
        "GUANACASTE",
        "PUNTARENAS",
        "LIMON"
      ]
    },
    "guardian": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::guardian.guardian",
      "required": false
    },
    "visitor_type": {
      "type": "enumeration",
      "enum": [
        "LOCAL",
        "FOREIGNER"
      ]
    },
    "booking_tours": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::booking-tour.booking-tour",
      "mappedBy": "visitor_detail"
    }
  }
}
