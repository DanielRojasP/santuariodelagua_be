{
  "kind": "collectionType",
  "collectionName": "booking_tours",
  "info": {
    "singularName": "booking-tour",
    "pluralName": "booking-tours",
    "displayName": "BookingTour"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "date": {
      "type": "datetime",
      "required": true
    },
    "pax_count": {
      "type": "integer",
      "required": true
    },
    "is_guided": {
      "type": "boolean",
      "required": true
    },
    "total_tour_amount": {
      "type": "decimal",
      "required": true
    },
    "languague": {
      "type": "string",
      "required": true
    },
    "duration": {
      "type": "integer",
      "required": true
    },
    "status_tour": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "PENDING",
        "CONFIRMED",
        "CANCELED",
        "REFUNDED",
        "FINISHED"
      ]
    },
    "tour": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::tour.tour"
    },
    "guides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::guide.guide",
      "mappedBy": "booking_tour"
    },
    "visitor_details": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::visitor-detail.visitor-detail"
    }
  }
}
