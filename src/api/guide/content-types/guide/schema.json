{
  "kind": "collectionType",
  "collectionName": "guides",
  "info": {
    "singularName": "guide",
    "pluralName": "guides",
    "displayName": "Guide"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "languages": {
      "type": "json",
      "required": true
    },
    "is_available": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "guide_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "INTERNAL",
        "EXTERNAL"
      ]
    },
    "tour_operator": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::tour-operator.tour-operator",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "guide_type"
            },
            "EXTERNAL"
          ]
        }
      }
    },
    "tours": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tour.tour",
      "inversedBy": "guides"
    },
    "booking_tour": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::booking-tour.booking-tour",
      "inversedBy": "guides"
    }
  }
}
